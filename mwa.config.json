{
  "models": {
    "fetch": "gpt-5-4-mini",
    "reason": "gpt-5-4-mini"
  },
  "awm": {},
  "tools": {
    "builtins": [
      "run_command",
      "read_file",
      "write_file",
      "list_files",
      "read_document"
    ],
    "mcpServers": {
      "fetch": {
        "command": "node",
        "args": [
          "mcp-servers/fetch.mjs"
        ]
      },
      "search": {
        "command": "node",
        "args": [
          "mcp-servers/search.mjs"
        ],
        "env": {
          "BRAVE_API_KEY": "${BRAVE_API_KEY}"
        }
      },
      "thinking": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-sequential-thinking@2025.12.18"
        ]
      },
      "docs": {
        "command": "npx",
        "args": [
          "-y",
          "@upstash/context7-mcp@3.2.1"
        ],
        "env": {
          "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
        }
      },
      "browser": {
        "command": "npx",
        "args": [
          "-y",
          "@playwright/mcp@0.0.76"
        ]
      }
    }
  },
  "escalation": {
    "maxFetchFailures": 2
  },
  "style": "guided"
}
