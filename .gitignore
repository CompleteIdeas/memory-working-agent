# desktop (Tauri) build staging — the bundled runtime is reassembled by the build
build/

# Per-run gauntlet artifacts live in ./gauntlet-runs (NOT under results/, which
# run.ts:56 rmSync's at startup — nesting them there destroyed the baseline arm).
# Ignored by default as run artifacts; commit one deliberately when it backs a
# documented claim.
gauntlet-runs/*.json

# results/ is the gauntlet's SCRATCH AREA — run.ts:56 rmSync()s it at startup, so
# anything committed here is deleted by the next run. Retained evidence belongs in
# gauntlet-runs/ instead.
results/
