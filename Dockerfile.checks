# The sandbox image for the check runner (BL-14c, docs/self-build.md).
#
# Built by `mwa check-runner` from YOUR trusted checkout — never from the worktree MWA edits — so MWA
# cannot change the dependencies, the toolchain or this file. It holds only what checks need: the
# installed dependencies (with better-sqlite3 compiled), the pinned AWM built, and the recall models
# baked in, because a check run has no network. The code under test is mounted read-only at run time.
FROM node:22

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 build-essential ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /base
COPY package.json package-lock.json* ./
COPY web/package.json ./web/
COPY vendor/agent-working-memory/package.json ./vendor/agent-working-memory/
RUN npm install --no-audit --no-fund
COPY vendor/agent-working-memory ./vendor/agent-working-memory
RUN npm run build:awm

# The recall models, downloaded now (the build has network; a check run doesn't).
COPY scripts/prewarm.ts ./scripts/prewarm.ts
COPY src ./src
COPY tsconfig.json ./
RUN MWA_DB=/tmp/prewarm.db npx tsx scripts/prewarm.ts && rm -rf /tmp/prewarm.db* src scripts

# A check runs as an unprivileged user.
RUN useradd --uid 1001 --create-home checker
USER checker
