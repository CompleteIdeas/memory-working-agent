# Copy to .env (next to docker-compose.yml) and edit. Compose reads it automatically.
# This file holds ONLY the deployment knobs — your AI provider keys are entered in the
# guided setup screen in the browser and stored on the /data volume, never here.

# Locks the UI + API behind one shared password. Set a strong value for any NAS /
# networked deployment. Leave blank only if access is already private (Tailscale-only).
MWA_ACCESS_PASSWORD=

# Timezone for scheduled ("every day at 7am…") tasks.
TZ=America/New_York

# ── Networking ────────────────────────────────────────────────────────────────
# Bind address. 127.0.0.1 = localhost only (default). Set 0.0.0.0 to expose on the
# network — do that ONLY together with MWA_ACCESS_PASSWORD above (or behind Tailscale).
# MWA_SERVE_HOST=127.0.0.1
# MWA_SERVE_PORT=7788

# ── Safety ⚠ ──────────────────────────────────────────────────────────────────
# Allow scheduled/unattended runs to confirm WRITE actions with no human present.
# Leave unset (off) unless you intend autonomous writes.
# MWA_ALLOW_UNATTENDED_WRITES=

# ── Memory backend ─────────────────────────────────────────────────────────────
# sqlite (default) | pglite | postgres. For postgres, set AWM_DATABASE_URL.
# AWM_STORE_BACKEND=sqlite
# AWM_DATABASE_URL=postgres://user:pass@host:5432/awm

# ── Model override (optional; normally set in the setup screen) ──────────────────
# MWA_MODEL=azure:gpt-5-4-mini

# ── Per-person Profile (S1–S6) ──────────────────────────────────────────────────
# Off-switches (default on). See docs/true-agent-and-person-profile.md.
# MWA_PERSON_PROFILE=0
# MWA_PERSON_LEARN=0

# ── Connectors (optional) ────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHATS=
# TAILSCALE_AUTHKEY=

# Full reference: docs/configuration.md
